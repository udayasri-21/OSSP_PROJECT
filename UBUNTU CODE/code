
#define _POSIX_C_SOURCE 200809L

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <signal.h>

void show_process_tree(void) {
    printf("\n=== LINUX PROCESS TREE ===\n");
    fflush(stdout);

    execlp("ps", "ps", "-eo",
           "pid,ppid,stat,comm", "--forest",
           (char *)NULL);

    perror("execlp");
    exit(EXIT_FAILURE);
}

void create_process(void) {
    printf("\n=== PROCESS CREATION USING fork() ===\n");
    printf("Parent PID: %ld\n", (long)getpid());
    fflush(stdout);

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        return;
    }

    if (pid == 0) {
        printf("Child process created!\n");
        printf("Child PID: %ld\n", (long)getpid());
        printf("Parent PID: %ld\n", (long)getppid());
        _exit(EXIT_SUCCESS);
    } else {
        printf("Parent created child PID: %ld\n", (long)pid);

        int status;
        waitpid(pid, &status, 0);

        printf("Child process terminated.\n");
    }
}

void execute_program(void) {
    printf("\n=== PROGRAM EXECUTION USING exec() ===\n");
    printf("Current PID: %ld\n", (long)getpid());
    fflush(stdout);

    execlp("echo", "echo",
           "Hello! A new program is executing.",
           (char *)NULL);

    perror("execlp failed");
}

void wait_for_child(void) {
    printf("\n=== PARENT WAITING FOR CHILD ===\n");
    fflush(stdout);

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        return;
    }

    if (pid == 0) {
        printf("Child is working...\n");
        fflush(stdout);
        _exit(7);
    }

    int status;

    waitpid(pid, &status, 0);

    if (WIFEXITED(status)) {
        printf("Child exited with status: %d\n",
               WEXITSTATUS(status));
    }
}

void signal_demo(void) {
    printf("\n=== SIGNAL DEMONSTRATION ===\n");

    struct sigaction action;
    memset(&action, 0, sizeof(action));

    action.sa_handler = SIG_IGN;
    sigemptyset(&action.sa_mask);

    if (sigaction(SIGUSR1, &action, NULL) == -1) {
        perror("sigaction");
        return;
    }

    printf("Sending SIGUSR1 to this process...\n");

    if (kill(getpid(), SIGUSR1) == -1) {
        perror("kill");
        return;
    }

    printf("Signal received and ignored by configured handler.\n");
}

void pipe_demo(void) {
    printf("\n=== INTER-PROCESS COMMUNICATION ===\n");

    int fd[2];

    if (pipe(fd) == -1) {
        perror("pipe");
        return;
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork");
        close(fd[0]);
        close(fd[1]);
        return;
    }

    if (pid == 0) {
        close(fd[1]);

        char buffer[100] = {0};
        ssize_t n = read(fd[0], buffer, sizeof(buffer) - 1);

        if (n >= 0) {
            buffer[n] = '\0';
            printf("Child received: %s\n", buffer);
        }

        close(fd[0]);
        _exit(EXIT_SUCCESS);
    }

    close(fd[0]);

    const char *message = "Hello from parent process";

    if (write(fd[1], message, strlen(message)) == -1) {
        perror("write");
    }

    close(fd[1]);

    waitpid(pid, NULL, 0);
    printf("Parent and child communication completed.\n");
}

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s [tree|fork|exec|wait|signal|ipc]\n",
               argv[0]);
        return EXIT_FAILURE;
    }

    if (strcmp(argv[1], "tree") == 0) {
        show_process_tree();
    } else if (strcmp(argv[1], "fork") == 0) {
        create_process();
    } else if (strcmp(argv[1], "exec") == 0) {
        execute_program();
    } else if (strcmp(argv[1], "wait") == 0) {
        wait_for_child();
    } else if (strcmp(argv[1], "signal") == 0) {
        signal_demo();
    } else if (strcmp(argv[1], "ipc") == 0) {
        pipe_demo();
    } else {
        printf("Invalid option.\n");
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
